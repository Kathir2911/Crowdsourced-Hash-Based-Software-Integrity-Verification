# Crowdsourced Hash Verification System - Git Ignore

# ============================================
# Backend (Java/Spring Boot/Maven)
# ============================================

# Maven
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd

# Build artifacts
*.class
*.jar
*.war
*.ear
*.nar

# Log files
backend/logs/
backend/*.log
*.log.*
*.gz

# Environment files
backend/.env
backend/.env.local
backend/.env.*.local

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# JQwik database
backend/.jqwik-database

# ============================================
# Browser Extension (TypeScript/Node)
# ============================================

# Dependencies
browser-extension/node_modules/
browser-extension/package-lock.json

# Build output
browser-extension/dist/
browser-extension/build/

# Test coverage
browser-extension/coverage/
browser-extension/.nyc_output/

# TypeScript cache
browser-extension/*.tsbuildinfo

# ============================================
# Database
# ============================================

# PostgreSQL
*.sql.backup
*.dump

